<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>澄</Author>
    <Name>魔光键影</Name>
    <Punchline>进入魔光键影后按副本词条输入，每句间隔约 2 秒。尚未经实机确认。</Punchline>
    <Description>进入用途为魔光键影的副本后，读取副本导演上的词条并输入。优先打断正在咏唱的敌人，其次是屏障类词条，其余打最近的敌人。每句之间默认间隔 2000 毫秒。禁止或沉默时暂停。默认关闭。尚未经实机确认。</Description>
    <Changelog>0.1.0.0 测试版。从副本导演读取词条并输入，默认每句间隔约 2 秒。尚未经实机确认。</Changelog>
    <PackageProjectUrl>https://github.com/SumiRayki/MoguangJianying</PackageProjectUrl>
    <RepoUrl>https://github.com/SumiRayki/MoguangJianying</RepoUrl>
    <Tags>goldsaucer;keybound;typing</Tags>
    <CategoryTags>Utility</CategoryTags>
    <AcceptsFeedback>false</AcceptsFeedback>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MoguangJianying</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
